---
import Layout from '../layouts/Layout.astro';

const calendarUrl = "https://calendar.google.com/calendar/appointments/schedules/AcZssZ2BC7qlQaZiNfqdneIL574ngJwCj-7QaMPyc4EKyiU_s1xRqxFQX1pomi-LGXj5RzcJS-vkf5OQ?gv=true";
---

<Layout
  title="Pago confirmado — FisioFelix"
  description="Tu reserva en FisioFelix ha sido confirmada."
>
  <div class="min-h-screen bg-surface flex items-center justify-center px-4 py-16">
    <div class="bg-white rounded-3xl shadow-hover p-10 max-w-md w-full text-center">
      <div class="w-20 h-20 rounded-full bg-emerald-50 flex items-center justify-center mx-auto mb-6">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
      </div>
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-50 text-emerald-600 text-sm font-semibold mb-4">Reserva confirmada</div>
      <h1 class="font-heading text-2xl font-bold text-brand mb-3">¡Pago completado!</h1>
      <p class="text-slate-500 leading-relaxed mb-6">Hemos recibido tu pago. Ahora elige el día y la hora de tu sesión.</p>
      <a href={calendarUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 w-full px-7 py-4 bg-primary hover:bg-primary-dark text-white font-semibold rounded-2xl shadow-soft hover:shadow-card transition-all duration-300 hover:-translate-y-0.5 mb-4">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        Agendar mi cita ahora
      </a>
      <div class="bg-sky-50 rounded-2xl p-4 mb-6 text-sm text-slate-600">
        <p>¿Tienes alguna duda? Escríbenos:</p>
        <a href="tel:+34617627016" class="font-semibold text-primary hover:underline block mt-1">+34 617 62 70 16</a>
      </div>
      <a href="/" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 border-2 border-sky-200 text-primary font-semibold rounded-2xl hover:bg-sky-50 transition-all duration-300">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
        Volver al inicio
      </a>
    </div>
  </div>
</Layout>
