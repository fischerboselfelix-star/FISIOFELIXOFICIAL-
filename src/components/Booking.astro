---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const calendar30min = "https://calendar.app.google/tE5VwaKukRR1SiFE6";
const calendar1hora = "https://calendar.app.google/NPBzF8L7GMyavmgv5";

const pricing = [
  { id: 'short', label: t('booking.t1_label'), price: '25€', desc: t('booking.t1_desc'), popular: false },
  { id: 'long',  label: t('booking.t2_label'), price: '45€', desc: t('booking.t2_desc'), popular: true },
  { id: 'bono',  label: t('booking.t3_label'), price: '972€', desc: t('booking.t3_desc'), popular: false },
];
---

<section id="reservar" class="py-20 md:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16 reveal">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-sky-100 text-primary text-sm font-semibold mb-4">{t('booking.badge')}</div>
      <h2 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold text-brand mb-4">{t('booking.h2')}</h2>
      <p class="text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed">{t('booking.desc')}</p>
    </div>
    <div class="grid lg:grid-cols-2 gap-10 items-start">

      <!-- Columna izquierda — Calendario -->
      <div class="space-y-6 reveal">
        <h3 class="font-heading text-xl font-semibold text-brand flex items-center gap-2">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0EA5E9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          {t('booking.select_time')}
        </h3>
        <div class="rounded-3xl border border-sky-100 shadow-soft bg-gradient-to-br from-sky-50 to-white p-8 text-center">
          <div class="w-20 h-20 rounded-2xl bg-white shadow-card flex items-center justify-center mx-auto mb-5">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#0EA5E9" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <h4 class="font-heading font-bold text-xl text-brand mb-2">{t('booking.book_online')}</h4>
          <p class="text-slate-500 text-sm leading-relaxed mb-6 max-w-xs mx-auto">{t('booking.book_desc')}</p>
          <div class="grid grid-cols-3 gap-3 mb-7">
            {[
              { num: '1', text: t('booking.step1') },
              { num: '2', text: t('booking.step2') },
              { num: '3', text: t('booking.step3') },
            ].map(step => (
              <div class="bg-white rounded-2xl p-3 shadow-soft">
                <div class="w-7 h-7 rounded-full bg-primary text-white text-xs font-bold flex items-center justify-center mx-auto mb-1.5">{step.num}</div>
                <p class="text-xs text-slate-500 leading-tight">{step.text}</p>
              </div>
            ))}
          </div>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href={calendar30min} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 flex-1 px-5 py-3.5 bg-white border-2 border-primary text-primary hover:bg-primary hover:text-white font-semibold text-sm rounded-2xl shadow-soft hover:shadow-hover hover:-translate-y-0.5 transition-all duration-300">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              {t('booking.t1_label')}
            </a>
            <a href={calendar1hora} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 flex-1 px-5 py-3.5 bg-primary hover:bg-primary-dark text-white font-semibold text-sm rounded-2xl shadow-soft hover:shadow-hover hover:-translate-y-0.5 transition-all duration-300">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              {t('booking.t2_label')}
            </a>
          </div>
          <p class="text-xs text-slate-400 mt-3 flex items-center justify-center gap-1">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            {t('booking.secure')}
          </p>
        </div>
      </div>

      <!-- Columna derecha — Tarifas -->
      <div class="space-y-6 reveal">
        <h3 class="font-heading text-xl font-semibold text-brand flex items-center gap-2">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0EA5E9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
          {t('booking.rates')}
        </h3>
        <div class="space-y-4">
          {pricing.map((tier) => (
            <div class={`relative p-5 rounded-2xl border-2 transition-all duration-200 ${tier.popular ? 'border-primary bg-gradient-to-br from-sky-50 to-white shadow-card' : 'border-slate-100 bg-white hover:border-sky-200 shadow-soft hover:shadow-card'}`}>
              {tier.popular && (
                <span class="absolute -top-3 left-5 px-3 py-0.5 bg-primary text-white text-xs font-semibold rounded-full shadow-sm">{t('booking.popular')}</span>
              )}
              <div class="flex items-center justify-between gap-4">
                <div class="min-w-0">
                  <p class="font-heading font-semibold text-brand text-base leading-tight">{tier.label}</p>
                  <p class="text-sm text-slate-400 mt-0.5">{tier.desc}</p>
                </div>
                <span class="font-heading font-bold text-2xl text-primary flex-shrink-0">{tier.price}</span>
              </div>
              <button type="button" data-tier={tier.id} class="pay-btn mt-4 w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-sm font-semibold bg-primary/10 text-primary hover:bg-primary hover:text-white transition-all duration-200">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                {t('booking.pay_now')}
              </button>
            </div>
          ))}
        </div>
        <div class="flex items-center justify-center gap-6 pt-2">
          <div class="flex items-center gap-1.5 text-xs text-slate-400">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
            {t('booking.pay_secure')}
          </div>
          <div class="flex items-center gap-1.5 text-xs text-slate-400">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            {t('booking.ssl')}
          </div>
        </div>
        <div class="p-4 bg-sky-50/60 rounded-2xl border border-sky-100 text-sm text-slate-500 leading-relaxed">
          <strong class="text-brand">{t('booking.first_time')}</strong> {t('booking.first_time_desc')}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const BACKEND = (import.meta as any).env?.PUBLIC_BACKEND_URL ?? '';
  document.querySelectorAll<HTMLButtonElement>('.pay-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const tier = btn.dataset.tier!;
      const original = btn.innerHTML;
      btn.textContent = '...';
      btn.disabled = true;
      try {
        const res = await fetch(`${BACKEND}/api/checkout/session`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ tier, origin_url: window.location.origin }),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const { url } = await res.json() as { url: string };
        window.location.href = url;
      } catch {
        btn.innerHTML = original;
        btn.disabled = false;
        btn.textContent = '⚠ Error';
        setTimeout(() => { btn.innerHTML = original; }, 3000);
      }
    });
  });
</script>
